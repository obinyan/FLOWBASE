# Copy this file to .env.local (never commit .env.local) and fill in both values.
# Supabase dashboard -> your project -> Connect (or Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# NEVER put the secret / service_role key in this app's browser code or in a NEXT_PUBLIC_ variable.
